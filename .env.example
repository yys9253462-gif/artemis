# ==============================================================================
# Artemis 运行环境配置模板 (.env)
# ==============================================================================
# 请复制本文件并重命名为 .env，然后填写您的大模型凭证：
# cp .env.example .env

# 大模型 API 密钥凭证（至少配置一个，兼容中转站）
# 如果使用兼容 OpenAI 协议的中转站，请配置 OPENAI_API_KEY 与 OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Google Cloud Vision OCR 视觉增强密钥（可选，用于深度文字提取）
OCR_API_KEY=

# Android ADB 连接配置（可选，默认指向本地 127.0.0.1:5037）
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=（指定设备的序列号，如有多台设备可通过 adb devices 查看）

# 运行期间保持手机屏幕常亮（如果使用个人日常手机且需要息屏，可设置为 false）
ARTEMIS_KEEP_DEVICE_AWAKE=true

# UI 节点布局层级获取方式：auto (首选无障碍 Helper，UIAutomator2 作兜底) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto

# 是否允许执行任务时自动在手机上安装/更新 Artemis 无障碍辅助插件 (APK)
# 如果是共享或个人手机，可设为 false，并手动执行 `artemis helper install`
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis 默认执行架构 (flash: 极速反应式单模型 | pro: 深度认知多智能体图谱)
ARTEMIS_DEFAULT_PROFILE=flash
